{
    "js/ts.preferences.importModuleSpecifier": "relative",
    "js/ts.tsserver.maxMemory": 4096,
    "js/ts.tsserver.watchOptions": {
        "watchFile": "useFsEvents",
        "watchDirectory": "useFsEvents",
        "fallbackPolling": "fixedPollingInterval"
    },
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
    "js/ts.updateImportsOnFileMove.enabled": "always",
    "js/ts.suggest.autoImports": true,
    "js/ts.suggest.paths": true,
    "js/ts.tsdk.promptToUseWorkspaceVersion": true,
    "js/ts.implicitProjectConfig.experimentalDecorators": true,
    "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
    "typescript.surveys.enabled": false,
    "js/ts.implementationsCodeLens.enabled": false,
    "js/ts.referencesCodeLens.enabled": false,
    "js/ts.tsserver.useSyntaxServer": "auto",
    "typescript.tsserver.fileWatchingExclude": {
        "**/node_modules": true,
        "**/platforms": true,
        "**/www": true,
        "**/.sourcemaps": true,
        "**/.sass-cache": true,
        "**/.angular": true,
        "**/android": true
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "never"
    },
    "files.exclude": {
        "**/node_modules": true,
        "**/platforms": true,
        "**/www": true,
        "**/.sourcemaps": true,
        "**/.sass-cache": true,
        "**/.angular": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/platforms": true,
        "**/www": true,
        "**/.sourcemaps": true,
        "**/.sass-cache": true,
        "**/.angular": true,
        "**/android": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/platforms/**": true,
        "**/www/**": true,
        "**/.sourcemaps/**": true,
        "**/.sass-cache/**": true,
        "**/.angular/**": true,
        "**/android/**": true
    },
    "js/ts.tsdk.path": "node_modules\\typescript\\lib"
}